# Ambiente
AMBIENTE=PROD
NODE_ENV=production
PORT=3006

# Dominio publico da API, sem https:// em DOMINIO_API
# Exemplo:
# DOMINIO_API=api.seudominio.com
# API_PUBLIC_URL=https://api.seudominio.com
# API_HOST=api.seudominio.com
# RESOURCE_HOST=//api.seudominio.com
DOMINIO_API=api.seudominio.com
API_PUBLIC_URL=https://api.seudominio.com
API_HOST=api.seudominio.com
RESOURCE_HOST=//api.seudominio.com
LOCAL_CALLBACK_URL=https://api.seudominio.com

# Banco MySQL de producao
# Se usar MySQL na mesma EC2:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# Se usar RDS, coloque o endpoint do RDS em DB_HOST.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=phillypsapi
DB_PASSWORD=troque-esta-senha
DB_NAME=phillypsapi

# Padroes da integracao
DEFAULT_PROVIDER_CODE=PGSOFT
DEFAULT_CURRENCY=BRL

# Crie credenciais reais para producao.
DEMO_AGENT_CODE=demo
DEMO_AGENT_PASSWORD=troque-esta-senha
DEMO_AGENT_TOKEN=troque-este-token
DEMO_SECRET_KEY=troque-esta-secret

# Reservado para autenticacao interna futura.
API_SECRET=troque-este-valor

# Redis reservado; a API atual nao depende dele para subir.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
